# relay-avatar 凭据（部署位 shared/secrets/relay-avatar.env，chmod 600，不进 git）
# 首装由 provision 从 im-bridge/bridge.env 迁移；新机器手工填写后 touch /etc/relay-avatar.enabled

# relay API（设备鉴权三元组，relay 面板注册设备后发放）
RELAY_BASE=http://127.0.0.1:8787
RELAY_DEVICE_ID=
RELAY_DEVICE_SECRET=

# 监控看板 :8791（人用口令登录页，防爆破：同IP 15分钟内失败5次锁定；机用 X-Token）
AVATAR_DASHBOARD_PASSWORD=
AVATAR_DASHBOARD_TOKEN=

# P2 知识库（jingboWiki，可选；不填则仅本地 shared/knowledge 兜底）
JINGBOWIKI_BASE=
JINGBOWIKI_KEY=
