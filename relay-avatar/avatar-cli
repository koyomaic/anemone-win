#!/usr/bin/env python3
"""avatar-cli —— 本机直提入口（原 bridge-cli 演进；账号自发消息不进事件流的替代通道）。

用法:
  avatar-cli "任务描述"              提交并轮询到结束，打印结果
  avatar-cli "描述" --resume 123     续任务 123 的会话上下文
  avatar-cli "描述" --no-follow      只提交不等待
  avatar-cli --status                心跳/入站健康/最近快照
凭据走 shared/secrets/relay-avatar.env（与守护进程同源，设备鉴权）。
"""
import argparse
import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from app import config as C
from app.ingress_relay import RelayClient


def cmd_status(cfg):
    st = cfg.state
    out = {"state_dir": str(st)}
    try:
        hb = (st / "run" / "heartbeat").read_text().strip()
        out["heartbeat_age_sec"] = int(time.time() - float(hb))
    except Exception:
        out["heartbeat_age_sec"] = None
    try:
        out["inbound"] = json.loads(
            (st / "run" / "inbound_health.json").read_text("utf-8"))
    except Exception:
        out["inbound"] = None
    import socket
    snap = st / "run" / "monitor" / f"snapshot-{socket.gethostname()}.json"
    try:
        s = json.loads(snap.read_text("utf-8"))
        out["overall"] = s.get("overall")
        out["issues"] = [f'{i.get("label", i["target"])}: {i["msg"]}'
                         for i in s.get("issues", [])]
        out["snapshot_age_sec"] = int(time.time() - s.get("ts", 0))
    except Exception:
        out["overall"] = None
    port = cfg.get("monitor", "dashboard_port", 8791)
    out["dashboard"] = f"http://{socket.gethostname()}:{port}"
    print(json.dumps(out, ensure_ascii=False, indent=1))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("description", nargs="?", default="")
    ap.add_argument("--resume", type=int)
    ap.add_argument("--no-follow", action="store_true")
    ap.add_argument("--status", action="store_true")
    args = ap.parse_args()
    cfg = C.load()
    if args.status:
        return cmd_status(cfg)
    if not args.description:
        ap.error("需要任务描述（或 --status）")
    relay = RelayClient(cfg.env)
    if not relay.configured:
        print("relay-avatar.env 缺 RELAY_DEVICE_ID/SECRET", file=sys.stderr)
        sys.exit(1)
    r = relay.create_task(args.description, resume_from=args.resume,
                          project="avatar-cli")
    if "_error" in r:
        print("提交失败:", r, file=sys.stderr)
        sys.exit(1)
    tid = r["task_id"]
    print(f"task #{tid} {r.get('status')}")
    if args.no_follow:
        return
    last = ""
    while True:
        row = relay.get_task(tid)
        stt = row.get("status")
        if stt != last:
            print("status:", stt)
            last = stt
        if stt == "pending_approval":
            print("高危命令拦截:", row.get("blocked_cmd"))
            print("放行: 钉钉回「确认」或面板操作")
            return
        if stt == "review":
            print("待人工确认。结果:")
            print(row.get("result", ""))
            return
        if stt in ("done", "conflict", "failed", "cancelled"):
            if row.get("error"):
                print("error:", row["error"])
            print(row.get("result", ""))
            return
        if "_error" in row:
            print("poll error:", row, file=sys.stderr)
            return
        time.sleep(3)


if __name__ == "__main__":
    main()
