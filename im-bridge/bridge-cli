#!/usr/bin/env python3
"""bridge-cli: 本机直接给 relay 提任务（不经钉钉），供王洪彬/运维使用。

用法:
  bridge-cli "任务描述"            提交并轮询到结束，打印结果
  bridge-cli "描述" --resume 123   续任务 123 的会话上下文
  bridge-cli "描述" --no-follow    只提交不等待
"""
import argparse
import hashlib
import hmac
import json
import os
import secrets
import sys
import time
import urllib.error
import urllib.request

ENV = os.path.join(os.environ.get(
    "BRIDGE_STATE_DIR", "/mnt/vol-eltaah12/workspace/im-bridge"),
    "bridge.env")


def load_env():
    env = {}
    for line in open(ENV):
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            env[k] = v
    return env


def req(env, method, path, body=None):
    data = json.dumps(body).encode() if body is not None else b""
    ts = str(int(time.time()))
    nonce = secrets.token_hex(8)
    digest = hashlib.sha256(data).hexdigest()
    msg = f"{ts}\n{method}\n{path}\n{digest}\n{nonce}"
    sig = hmac.new(env["RELAY_DEVICE_SECRET"].encode(), msg.encode(),
                   hashlib.sha256).hexdigest()
    r = urllib.request.Request(env["RELAY_BASE"].rstrip("/") + path,
                               data=data or None, method=method, headers={
                                   "X-Device-Id": env["RELAY_DEVICE_ID"],
                                   "X-Timestamp": ts, "X-Nonce": nonce,
                                   "X-Signature": sig,
                                   "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(r, timeout=15) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        print("HTTP", e.code, e.read().decode()[:300], file=sys.stderr)
        sys.exit(1)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("description")
    ap.add_argument("--resume", type=int)
    ap.add_argument("--no-follow", action="store_true")
    args = ap.parse_args()
    env = load_env()
    body = {"description": args.description, "priority": "normal",
            "project": "im-bridge-cli"}
    if args.resume:
        body["resume_from"] = args.resume
    r = req(env, "POST", "/tasks", body)
    tid = r["task_id"]
    print(f"task #{tid} {r['status']}")
    if args.no_follow:
        return
    last = ""
    while True:
        row = req(env, "GET", f"/tasks/{tid}")
        st = row.get("status")
        if st != last:
            print("status:", st)
            last = st
        if st == "pending_approval":
            print("高危命令拦截:", row.get("blocked_cmd"))
            print(f"放行: curl -X POST .../tasks/{tid}/approve 或用面板")
            return
        if st == "review":
            print("待人工确认。结果:")
            print(row.get("result", ""))
            return
        if st in ("done", "conflict", "failed", "cancelled"):
            if row.get("error"):
                print("error:", row["error"])
            print(row.get("result", ""))
            return
        time.sleep(3)


if __name__ == "__main__":
    main()
