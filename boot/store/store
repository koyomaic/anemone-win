def wiki_sync_eligible(row: dict) -> tuple[bool, str]:
    """四库短期同步闸门：文本、大小、敏感度与路径白名单。"""
    path = row.get("path", "")
    if not is_four_lib_rel(path):
        return False, "out_of_four_lib_scope"
    if is_archived_knowledge_rel(path) or is_stale_four_lib_rel(path):
        return False, "archived_or_stale"
    ext = os.path.splitext(path)[1].lower()
    if ext not in WIKI_TEXT_EXT:
        return False, "unsupported_ext"
    try:
        if int(row.get("size") or 0) > WIKI_MAX_BYTES:
            return False, "too_large"
    except (TypeError, ValueError):
        return False, "bad_size"
    if str(row.get("sensitivity") or "").lower() == "sensitive":
        return False, "sensitive"
    return True, ""


