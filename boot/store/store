            meta = {"store_path": r["path"], "sha256": r["sha256"], "domain": r["domain"],
                    "topic": r["topic"] or "", "sender_id": r["sender_id"] or "",
                    "task_id": str(r["task_id"] or ""), "sensitivity": r["sensitivity"],
                    "authority": "jingbowiki", "synced_by": "store-sync/1.0"}
            res = _wiki_upload(tok, kb, abs_p, tag_id, meta)
            pid = ((res.get("data") or {}).get("id") if isinstance(res.get("data"), dict) else "") or ""
            if res.get("success") and pid:
                # 受理即成功：解析在后台异步，不阻塞等待
                cur.execute("""UPDATE store_files SET wiki_page_id=%s, wiki_status='accepted',
                               wiki_tag=COALESCE(NULLIF(wiki_tag,''),domain), wiki_synced_at=%s,
                               updated_at=%s WHERE id=%s""",
                            (pid, time.time(), time.time(), r["id"]))
                _log_sync(cur, r["id"], "push", pid, "accepted", fn)
                pushed.append({"path": r["path"], "page_id": pid, "mode": "upload", "tag": tag_id})
            else:
                _log_sync(cur, r["id"], "push", "", "failed", json.dumps(res, ensure_ascii=False)[:400])
                failed.append({"path": r["path"], "res": res})
        conn.close()
        return out({"ok": not failed, "scope": scope, "pattern": pattern or None,
                    "pushed": pushed, "failed": failed,
                    "scope_skipped": len(scope_skipped),
                    "scope_skipped_paths": scope_skipped[:50],
                    "ineligible": ineligible[:50]})

    if a.action == "verify":
        upd = []
        for r in local:
            if not r["wiki_page_id"]:
                continue
            hit = next((x for x in remote if x.get("id") == r["wiki_page_id"]), None)
            if not hit:
                cur.execute("UPDATE store_files SET wiki_status='missing', updated_at=%s WHERE id=%s",
                            (time.time(), r["id"]))
                upd.append({"path": r["path"], "wiki_status": "missing", "why": "wiki 侧已不存在"})
                continue
            st = (hit.get("parse_status") or hit.get("status") or "").lower()
            new = {"completed": "indexed", "success": "indexed", "done": "indexed",
                   "failed": "failed", "error": "failed"}.get(st, "parsing")
            cur.execute("UPDATE store_files SET wiki_status=%s, updated_at=%s WHERE id=%s",
                        (new, time.time(), r["id"]))
            _log_sync(cur, r["id"], "verify", r["wiki_page_id"], new, st)
            upd.append({"path": r["path"], "wiki_status": new, "parse": st,
                        "tags": [t.get("name") for t in (hit.get("tags") or [])]})
        conn.close()
        return out({"ok": True, "scope": scope, "pattern": pattern or None,
                    "checked": len(upd), "rows": upd})

    if a.action == "backfill":  # 给已存在但服务端 tag 为空/不符的条目补 tag
        updates = {}
        for r in remote:
            fn = r.get("file_name")
            row = next((x for x in local if os.path.basename(x["path"]) == fn), None)
            if not row:
                continue
            want = tags.get(row["wiki_tag"] or row["domain"], "")
            tids = [t.get("id") for t in (r.get("tags") or [])]
            # 实测契约：updates 的值必须是 []string（api.md 写的 string|null 是错的，
            # 传字符串会 400 "cannot unmarshal string into ... of type []string"）
            if want and want not in tids:
                updates[r["id"]] = [want]
        if updates:
            res = _wiki(tok, "PUT", "/knowledge/tags", {"kb_id": kb, "updates": updates})
            for pid, tid in updates.items():
                cur.execute("""UPDATE store_files SET wiki_synced_at=%s, updated_at=%s
                               WHERE wiki_page_id=%s""", (time.time(), time.time(), pid))
                row = next((x for x in local if x["wiki_page_id"] == pid), None)
                if row:
                    _log_sync(cur, row["id"], "tag", pid, row["wiki_status"], f"tag_ids={tid}")
            conn.close()
            return out({"ok": bool(res.get("success")), "scope": scope,
                        "pattern": pattern or None, "tagged": len(updates),
                        "updates": updates, "res": res})
        conn.close()
        return out({"ok": True, "scope": scope, "pattern": pattern or None,
                    "tagged": 0, "note": "无需补 tag"})

    conn.close()
    raise SystemExit(f"未知 sync 动作: {a.action}")


def main() -> None:
    ap = argparse.ArgumentParser(prog="store", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=os.environ.get("STORE_ROOT", DEFAULT_ROOT))
    ap.add_argument("--workspace",
                    default=os.environ.get("STORE_WORKSPACE", DEFAULT_WORKSPACE),
                    help="存量盘点基准根（root='workspace' 的行按此解析）")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="建扩展/表/索引 + 目录骨架 + 种子 + 任务侧最小权限角色")
    p.add_argument("--rotate-task-role", dest="rotate_task_role", action="store_true",
                   help=f"强制轮换 {TASK_ROLE} 角色密码（默认已有角色且凭据文件在则不轮换，"
                        "避免打断在途任务）")
    p.set_defaults(f=cmd_init)
    sub.add_parser("skeleton", help="只建目录骨架与 index 配置，不碰数据库").set_defaults(f=cmd_skeleton)
    sub.add_parser("ping", help="探活：DB 可连 + 5 张表在（不建表；缺表退出码 1）").set_defaults(f=cmd_ping)

    p = sub.add_parser("scan", help="扫描入库（按 path 幂等 upsert）")
    p.add_argument("--src", default="", help="要扫描的目录（默认 store 根）")
    p.add_argument("--kind", default="")
    p.add_argument("--domain", default="")
    p.add_argument("--status", default="indexed")
    p.add_argument("--pattern", default="")
    p.add_argument("--prefix", default="", help="入库 path 前缀（存量盘点用，如 shared/data）")
    p.add_argument("--root-name", dest="root_name", default="store",
                   choices=("store", "workspace"),
                   help="path 的基准根：store=新存储根，workspace=存量盘点")
    p.add_argument("--skip-archive", action="store_true")
    p.set_defaults(f=cmd_scan)

    p = sub.add_parser("add", help="登记单个文件")
    p.add_argument("path")
    p.add_argument("--rel", default="")
    p.add_argument("--kind", default="")
    p.add_argument("--domain", default="")
    p.add_argument("--status", default="indexed")
    p.add_argument("--sender", default="")
    p.add_argument("--task", type=int, default=None)
    p.add_argument("--sensitivity", default="")
    p.add_argument("--authority", default="")
    p.add_argument("--wiki-tag", dest="wiki_tag", default="",
                   help="jingboWiki 标签名（knowledge 类缺省取 domain）")
    p.add_argument("--wiki-status", default="")
    p.add_argument("--note", default="")
    p.set_defaults(f=cmd_add)

    p = sub.add_parser("set", help="改台账字段（迁移重映射/登记 wiki/标注缺口）")
    p.add_argument("id", type=int)
    for _f in SETTABLE:
        p.add_argument("--" + _f.replace("_", "-"), dest=_f, default=None)
    p.add_argument("--task-id", dest="task_id", type=int, default=None)
    p.add_argument("--archived", dest="archived", default=None,
                   type=lambda s: s.lower() in ("1", "true", "yes"))
    p.add_argument("--log-wiki", dest="log_wiki", default="",
                   help="同时写 store_wiki_sync 流水：push|verify|pull|tag|skip")
    p.set_defaults(f=cmd_set)

    p = sub.add_parser("q", help="查询")
    for k in ("kind", "domain", "status", "wiki_status", "variant", "sensitivity",
              "authority", "sender", "topic", "path", "since", "until"):
        p.add_argument(f"--{k.replace('_','-')}", dest=k, default="")
    p.add_argument("--task", type=int, default=None)
    p.add_argument("--limit", type=int, default=50)
    p.add_argument("--include-archived", action="store_true")
    p.add_argument("--format", default="table", choices=("table", "json"))
    p.set_defaults(f=cmd_q)

    sub.add_parser("dup", help="sha256 重复检测").set_defaults(f=cmd_dup)
    sub.add_parser("doctor", help="DB↔磁盘对账 + 命名违规 + 缺口").set_defaults(f=cmd_doctor)

    p = sub.add_parser("export", help="PG → index/manifest.jsonl")
    p.add_argument("--out", default="")
    p.set_defaults(f=cmd_export)

    p = sub.add_parser("lineage", help="血缘树")
    p.add_argument("id", type=int)
    p.set_defaults(f=cmd_lineage)

    p = sub.add_parser("link", help="登记血缘边")
    p.add_argument("src", type=int)
    p.add_argument("dst", type=int)
    p.add_argument("--rel", default="derived_from")
    p.set_defaults(f=cmd_link)

    sub.add_parser("today", help="刷新并输出 index/today.json").set_defaults(f=cmd_today)

    p = sub.add_parser("sync", help="jingboWiki 同步")
    p.add_argument("action", choices=("tags", "scan", "push", "verify", "backfill"))
    p.add_argument("--kb", default=None,
                   help="缺省按机解析：STORE_KB_ID env > jingbowiki.env 的 JINGBOWIKI_KB_ID")
    p.add_argument("--scope", default="fourlib", choices=("fourlib", "all"),
                   help="短期默认只同步 knowledge 四库；--scope all 才恢复全量 knowledge")
    p.add_argument("--pattern", default="",
                   help="在 scope 结果内再按路径正则过滤，如 '/知识库/'")
    p.set_defaults(f=cmd_sync)

    a = ap.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
