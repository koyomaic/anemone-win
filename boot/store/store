def _wiki_login() -> str:
    import urllib.request
    email, pw = _wiki_creds()
    if not email or not pw:
        raise SystemExit("缺 JINGBOWIKI_EMAIL / JINGBOWIKI_PASSWORD（查 shared/secrets/jingbowiki.env）")
    req = urllib.request.Request(WIKI_BASE + "/auth/login",
                                 data=json.dumps({"email": email, "password": pw}).encode(),
                                 headers={"Content-Type": "application/json"}, method="POST")
    d = json.load(urllib.request.urlopen(req, timeout=40))
    tok = d.get("token") or (d.get("data") or {}).get("token")
    if not tok:
        raise SystemExit("登录未返回 token")
    return tok


def _wiki(tok: str, method: str, path: str, body=None):
    import urllib.request
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(WIKI_BASE + path, data=data, method=method,
                                 headers={"Authorization": "Bearer " + tok,
                                          "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=90) as r:
        return json.load(r)


def _wiki_rows(tok: str, kb: str) -> list[dict]:
    d = _wiki(tok, "GET", f"/knowledge-bases/{kb}/knowledge?page=1&page_size=500")
    data = d.get("data")
    return data if isinstance(data, list) else ((data or {}).get("data") or [])


def _wiki_upload(tok: str, kb: str, path: str, tag_id: str, meta: dict) -> dict:
    import subprocess
    cmd = ["curl", "-s", "-m", "240", "-X", "POST",
           f"{WIKI_BASE}/knowledge-bases/{kb}/knowledge/file",
           "-H", f"Authorization: Bearer {tok}",
           "-F", f"file=@{path}", "-F", "channel=api", "-F", "enable_multimodel=false"]
    if tag_id:
        cmd += ["-F", f"tag_ids={tag_id}"]
    if meta:  # 键值均须为字符串
        cmd += ["-F", "metadata=" + json.dumps({k: str(v) for k, v in meta.items()},
                                               ensure_ascii=False)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=260)
    try:
        return json.loads(r.stdout)
    except Exception:
        return {"success": False, "raw": r.stdout[:300], "err": r.stderr[:300]}


