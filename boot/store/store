def load_db_url() -> str:
    url = os.environ.get("RELAY_DB", "").strip()
    if url:
        return url
    p = os.environ.get("STORE_ENV", DEFAULT_ENV)
    if os.path.isfile(p):
        for line in open(p, encoding="utf-8"):
            line = line.strip()
            if line.startswith("export "):
                line = line[7:].strip()
            if line.startswith("RELAY_DB="):
                return line.split("=", 1)[1].strip().strip('"').strip("'")
    raise SystemExit("找不到 RELAY_DB（环境变量或 relay.env）")


def connect():
    c = psycopg2.connect(load_db_url(), connect_timeout=10,
                         cursor_factory=psycopg2.extras.RealDictCursor)
    c.autocommit = True
    return c


def sha256(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def iso_week(d: date) -> str:
    y, w, _ = d.isocalendar()
    return f"{y}-W{w:02d}"


def parse_fname(fn: str) -> dict:
    """按命名约定解析文件名；不合约定返回空 dict（存量文件走人工映射表）。"""
    m = FNAME.match(fn)
    if not m:
        return {}
    g = m.groupdict()
    ds = g["date"]
    d = date(int(ds[:4]), int(ds[4:6]), int(ds[6:]))
    return {"fdate": d.isoformat(), "sender_id": g["sender"] or "",
            "task_id": int(g["task"][1:]) if g["task"] and g["task"] != "T0" else None,
            "topic": g["topic"], "variant": g["variant"] or "",
            "version": int(g["ver"]), "ext": g["ext"]}


def infer_kind(rel: str) -> str:
    top = rel.split("/")[0]
    return {"data": "data", "report": "report", "work": "work",
            ".archive": "archive"}.get(top, "shared" if top == "shared" else top)


def infer_domain(rel: str, kind: str) -> str:
    """从路径推域名。只有 report / knowledge 有域层，data 按日期+发送人分层无域。

    兼容两种布局：
      相对 kind 根（存量盘点 --src shared/reports）：会议纪要/2026-09/x.md
      相对 store 根（正常扫描）：              report/会议纪要/2026-09/x.md
    """
    if kind not in ("report", "knowledge"):
        return ""
    parts = [p for p in rel.split("/") if p]
    if parts and parts[0] in ("report", "data", "work", "shared"):
        parts = parts[1:]
    if parts and parts[0] == "knowledge":
        parts = parts[1:]
    # 至少要有「域/文件」两段，否则说明文件直接位于 kind 根下，无域层
    return parts[0] if len(parts) >= 2 else ""


def period_of(fdate: str, fmt: str) -> str:
    if not fdate:
        return ""
    d = date.fromisoformat(fdate)
    return iso_week(d) if fmt == "YYYY-Www" else fdate[:7]


def write_today(root: str) -> dict:
    d = date.today()
    info = {"date": d.isoformat(), "month": d.strftime("%Y-%m"), "week": iso_week(d),
            "data_dir": f"data/{d:%Y}/{d:%Y-%m}/{d:%Y-%m-%d}"}
    ip = os.path.join(root, "index")
    os.makedirs(ip, exist_ok=True)
    with open(os.path.join(ip, "today.json"), "w", encoding="utf-8") as f:
        json.dump(info, f, ensure_ascii=False, indent=2)
    return info


