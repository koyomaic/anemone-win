    out({"ok": True, "root": a.root, "dirs_created": made, "today": info,
         "note": "仅建目录与 index 配置，未触碰数据库"})


def _machine_tag() -> str:
    """本机稳定标识：/etc/machine-id 前 8 位（缺失回落 hostname）。

    为什么任务侧角色必须**每机私有**：store_task 曾是全机队共享的单一 PG 角色
    （10.189.21.235 上 8 台机器 10.189.51.23/.29-.35 同库，另带 pgautofailover），
    而 index/store-task.env 是每机本地文件（/mnt/vol-eltaah12 为 /dev/vdc 本地
    ext4，非网络挂载）。共享角色 + 每机密码文件 + 自动轮换 = 任何一台轮换都让
    其余 7 台立即失效 → 各自 provision 检测到 rc=3 再轮换 → 夜夜互相打断，且
    每轮都报「已自愈 PASS」而在检查清单上隐形（2026-09-25 轮换风暴）。

    轮换共享秘密必然使其他持有者失效——自愈只有在凭据本机私有时才安全。
    """
    try:
        mid = open("/etc/machine-id", encoding="utf-8").read().strip()
    except OSError:
        mid = ""
    tag = re.sub(r"[^a-z0-9]", "", mid.lower())[:8]
    if not tag:
        tag = re.sub(r"[^a-z0-9]", "", os.uname().nodename.lower())[:8]
    return tag or "local"


def _task_role() -> str:
    """任务侧 PG 角色名（每机私有）。STORE_TASK_ROLE 可覆盖（测试/特殊机）。

    角色名是 SQL 标识符、无法参数化绑定，只能拼进语句，故必须校验字符集防注入。
    """
    r = (os.environ.get("STORE_TASK_ROLE") or f"store_task_{_machine_tag()}").strip()
    if not re.fullmatch(r"[a-z_][a-z0-9_]{0,62}", r):
        raise SystemExit(f"STORE_TASK_ROLE 非法（须匹配 ^[a-z_][a-z0-9_]{{0,62}}$）: {r!r}")
    return r


TASK_ROLE = _task_role()

# 任务侧最小权限：只给 store_* 表与 tasks 的 id/status 两列。
# users/devices（成员 token 与设备密钥）明确不授权，REVOKE 兜底防默认权限泄漏。
# 台账允许任务写（add/set），但 doctor 以磁盘为准对账，篡改可被发现。
# 角色名每机私有（见 _machine_tag），故用 {r} 模板而非硬编码角色名。
GRANT_TMPL = [
    "GRANT USAGE ON SCHEMA public TO {r}",
    "GRANT SELECT, INSERT, UPDATE ON store_files, store_refs, store_wiki_sync TO {r}",
    "GRANT SELECT ON store_senders, store_domains TO {r}",
    "GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO {r}",
    "GRANT SELECT (id, status) ON tasks TO {r}",
    "REVOKE ALL ON users, devices FROM {r}",
]


def _task_dsn_works(env_p: str) -> bool:
    """实测 index/store-task.env 里的凭据能否真的连上库。

    为什么必须实测：ensure_task_role 原本只看「角色在 + 文件在」就沿用旧密码，
    一旦库侧密码与文件不一致（角色被重建、密码在别处改过、恢复过备份），
    store init 会**静默沿用失效凭据**，重跑多少次都修不好。
    2026-09-24 事故：#152/#204/#215 连续三次报
    `password authentication failed for user "store_task"`，当天全部交付件
    （两份 PPT + 市场研判 HTML）都进不了台账，agent 只能如实上报等人工。
    """
    dsn = ""
    try:
        for line in open(env_p, encoding="utf-8"):
            line = line.strip()
            if line.startswith("export "):
                line = line[7:].strip()
            if line.startswith("STORE_DB="):
                dsn = line.split("=", 1)[1].strip().strip('"').strip("'")
                break
    except OSError:
        return False
    if not dsn:
        return False
    try:
        c = psycopg2.connect(dsn, connect_timeout=10)
        c.close()
        return True
    except Exception:
        return False


def ensure_task_role(cur, root: str, rotate: bool = False) -> dict:
    """建/更新任务侧最小权限角色，连接串写进 index/store-task.env（任务可读）。

    任务环境拿不到 RELAY_DB（executor 滤掉 RELAY_* 前缀）也读不到 relay.env
    （relay.service 的 InaccessiblePaths 物理屏蔽），所以必须有一条独立的、
    权限受限的连库路径，否则 store 在任务内完全不可用。

    自愈：沿用现有凭据前先**实测能否连上**，连不上就强制轮换（见 _task_dsn_works）。
    轮换现在是安全的——角色每机私有（TASK_ROLE 见 _machine_tag），只影响本机，
    不会像共享 store_task 那样打断机队其余机器（2026-09-25 轮换风暴）。
    """
    import secrets as _sec
    from urllib.parse import urlparse, quote

    u = urlparse(load_db_url())
    cur.execute("SELECT 1 FROM pg_roles WHERE rolname=%s", (TASK_ROLE,))
    existed = bool(cur.fetchone())
    env_p = os.path.join(root, "index", "store-task.env")
    # 已有角色且凭据文件在 → 原则上不轮换密码，避免打断在途任务；
    # --rotate-task-role 强制轮换；凭据实测失效则自动轮换（自愈）。
    healed = False
    reuse = existed and os.path.isfile(env_p) and not rotate
    if reuse and not _task_dsn_works(env_p):
        reuse, healed = False, True
    if reuse:
        pw = None
    else:
        pw = _sec.token_urlsafe(24)
        cur.execute((f"ALTER ROLE {TASK_ROLE} WITH LOGIN PASSWORD %s" if existed
                     else f"CREATE ROLE {TASK_ROLE} WITH LOGIN PASSWORD %s"), (pw,))
    cur.execute(f"ALTER ROLE {TASK_ROLE} SET statement_timeout = '60s'")
    for g in GRANT_TMPL:
        cur.execute(g.format(r=TASK_ROLE))
    if pw:
        netloc = f"{TASK_ROLE}:{quote(pw, safe='')}@{u.hostname}" + (f":{u.port}" if u.port else "")
        os.makedirs(os.path.dirname(env_p), exist_ok=True)
        with open(env_p, "w", encoding="utf-8") as f:
            f.write("# store 任务侧最小权限连接串（store init 生成；勿手改、勿外发、勿入 git）\n"
                    "# 权限边界靠 PG 角色授权（只 store_* 表 + tasks 的 id/status 两列），不靠文件模式\n"
                    f"STORE_DB=postgresql://{netloc}{u.path}\n")
        os.chmod(env_p, 0o644)  # 任务需可读
    return {"role": TASK_ROLE, "created": not existed, "password_rotated": bool(pw),
            "healed_stale_credentials": healed,
            "env": env_p if pw else "(沿用现有)"}


def cmd_ping(a) -> None:
    """探活：DB 可连 + 5 张表在 + 台账行数 + **任务侧凭据实测可用**。供 provision 用。

    退出码：0=正常；1=连上了但缺表（首次需 store init）；2=DB 不可达（relay 本身也已瘫，
    属需要钉钉预警的故障）；3=宿主侧正常但**任务侧凭据失效**（store init 可自愈）。
    provision 据此区分 WARN 与 FAIL。

    为什么必须实测任务侧凭据：此前只查 `pg_roles` 里角色**存在**，不验密码**可用**。
    角色在、密码失效时 ping 照样返回 ok，provision [36] 一路 PASS，而任务里
    store add 全部失败——2026-09-24 当天三份交付件因此都没进台账，故障在检查清单
    上完全隐形。
    """
    try:
        conn = connect()
    except Exception as e:
        out({"ok": False, "stage": "connect", "error": str(e).splitlines()[0],
             "hint": "DB 不可达或凭据缺失——relay 依赖同一个库，通常意味着服务已瘫，需预警"})
        sys.exit(2)
    cur = conn.cursor()
    missing = []
    for t in ("store_files", "store_refs", "store_senders", "store_domains", "store_wiki_sync"):
        cur.execute("""SELECT 1 FROM information_schema.tables
                       WHERE table_schema='public' AND table_name=%s""", (t,))
        if not cur.fetchone():
            missing.append(t)
    n = role_ok = None
    task_dsn_ok = None
    if not missing:
        cur.execute("SELECT count(*) n FROM store_files")
        n = cur.fetchone()["n"]
        cur.execute("SELECT 1 FROM pg_roles WHERE rolname=%s", (TASK_ROLE,))
        role_ok = bool(cur.fetchone())
    conn.close()
    env_p = os.path.join(a.root, "index", "store-task.env")
    if not missing and os.path.isfile(env_p):
        # 实测任务侧**真正使用**的凭据。刻意不以 role_ok 为前提：迁移到每机私有
        # 角色期间新角色名尚未创建 → role_ok=False，而 env 里仍是旧共享角色的失效
        # DSN；若因 role_ok 跳过实测就会报 ok、而任务里 store add 全失败——正是
        # 2026-09-24 那类「清单全绿但功能已死」的静默失败。env 才是任务实际读的。
        task_dsn_ok = _task_dsn_works(env_p)
    hint = ""
    if missing:
        hint = "首次需人工执行: store init（会建表，属有副作用操作）"
    elif task_dsn_ok is False:
        hint = (f"任务侧凭据失效（{TASK_ROLE} 认证不过，或 env 内仍是旧共享角色 DSN）——"
                f"执行 store init 即可自愈：建每机私有角色并轮换（幂等、不动表数据、"
                f"不影响机队其他机器）")
    out({"ok": not missing and task_dsn_ok is not False,
         "missing_tables": missing, "store_files_rows": n,
         "task_role": TASK_ROLE if role_ok else None,
         "task_dsn_ok": task_dsn_ok, "root": a.root, "hint": hint})
    if missing:
        sys.exit(1)
    if task_dsn_ok is False:
        sys.exit(3)


