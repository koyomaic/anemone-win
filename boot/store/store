def cmd_set(a) -> None:
    """改台账字段（迁移重映射域、登记 wiki page_id、标注缺口都走这里）。"""
    sets, params = [], []
    for f in SETTABLE:
        v = getattr(a, f, None)
        if v is not None:
            sets.append(f"{f}=%s")
            params.append(v)
    if a.task_id is not None:
        sets.append("task_id=%s")
        params.append(a.task_id or None)
    if a.archived is not None:
        sets.append("archived=%s")
        params.append(a.archived)
    if not sets:
        raise SystemExit("没有要改的字段")
    if any(getattr(a, f, None) for f in ("wiki_page_id", "wiki_status", "wiki_tag")):
        sets.append("wiki_synced_at=%s")
        params.append(time.time())
    sets.append("updated_at=%s")
    params.append(time.time())
    conn = connect()
    cur = conn.cursor()
    cur.execute(f"UPDATE store_files SET {', '.join(sets)} WHERE id=%s", (*params, a.id))
    if cur.rowcount != 1:
        conn.close()
        raise SystemExit(f"id={a.id} 不存在（rowcount={cur.rowcount}）")
    if a.log_wiki:
        cur.execute("""INSERT INTO store_wiki_sync(file_id,action,wiki_page_id,wiki_status,detail,created_at)
                       VALUES(%s,%s,%s,%s,%s,%s)""",
                    (a.id, a.log_wiki, a.wiki_page_id or "", a.wiki_status or "",
                     a.note or "", time.time()))
    cur.execute("""SELECT id,path,domain,status,wiki_page_id,wiki_tag,wiki_status,note
                   FROM store_files WHERE id=%s""", (a.id,))
    r = dict(cur.fetchone())
    conn.close()
    out({"ok": True, "updated": r})


def _where(a) -> tuple[str, list]:
    # 列名一律加 f. 限定：q 会 JOIN store_senders(s) 与 tasks(t)，
    # sender_id / status 等在三张表里同名，不限定直接 AmbiguousColumn。
    w, p = [], []
    for col, val in (("kind", a.kind), ("domain", a.domain), ("status", a.status),
                     ("wiki_status", a.wiki_status), ("variant", a.variant),
                     ("sensitivity", a.sensitivity), ("authority", a.authority)):
        if val:
            w.append(f"f.{col}=%s")
            p.append(val)
    if a.sender:
        w.append("(f.sender_id=%s OR f.sender_id IN"
                 " (SELECT sender_id FROM store_senders WHERE name=%s))")
        p += [a.sender, a.sender]
    if a.task:
        w.append("f.task_id=%s")
        p.append(a.task)
    if a.topic:
        w.append("f.topic LIKE %s")
        p.append(f"%{a.topic}%")
    if a.path:
        w.append("f.path LIKE %s")
        p.append(f"%{a.path}%")
    if a.since:
        w.append("f.fdate>=%s")
        p.append(a.since)
    if a.until:
        w.append("f.fdate<=%s")
        p.append(a.until)
    if not a.include_archived:
        w.append("f.archived=FALSE")
    return (" WHERE " + " AND ".join(w) if w else ""), p


def cmd_q(a) -> None:
    conn = connect()
    cur = conn.cursor()
    clause, params = _where(a)
    cur.execute(f"""SELECT f.id,f.kind,f.path,f.domain,f.topic,f.variant,f.fdate,f.sender_id,
                     f.task_id,f.version,f.size,f.status,f.sensitivity,f.authority,
                     f.wiki_status,f.wiki_page_id,f.note,s.name AS sender_name,
                     t.status AS task_status
                    FROM store_files f
                    LEFT JOIN store_senders s ON s.sender_id=f.sender_id
                    LEFT JOIN tasks t ON t.id=f.task_id
                    {clause} ORDER BY f.fdate DESC, f.id DESC LIMIT %s""",
                (*params, a.limit))
    rows = [dict(r) for r in cur.fetchall()]
    conn.close()
    if a.format == "json":
        out({"count": len(rows), "rows": rows})
        return
    if not rows:
        print("（无匹配）")
        return
    for r in rows:
        tag = f" wiki={r['wiki_status']}" if r["wiki_page_id"] or r["wiki_status"] not in ("none", "") else ""
        who = r["sender_name"] or r["sender_id"] or "-"
        print(f"#{r['id']:<4} {r['fdate']} {r['kind']:<9} {r['domain'] or '-':<8} "
              f"{who:<6} T{r['task_id'] or 0:<4} {r['status']:<6}{tag}  {r['path']}")
        if r["note"]:
            print(f"      note: {r['note']}")


def cmd_dup(a) -> None:
    conn = connect()
    cur = conn.cursor()
    cur.execute("""SELECT sha256, count(*) n, array_agg(id ORDER BY id) ids,
                     array_agg(path ORDER BY id) paths
                   FROM store_files WHERE sha256<>'' AND archived=FALSE
                   GROUP BY sha256 HAVING count(*)>1 ORDER BY n DESC""")
    rows = [dict(r) for r in cur.fetchall()]
    conn.close()
    out({"duplicate_groups": len(rows),
         "wasted_bytes": sum(int(r["n"]) - 1 for r in rows),
         "groups": rows})


def cmd_doctor(a) -> None:
    conn = connect()
    cur = conn.cursor()
    bases = {"store": os.path.abspath(a.root), "workspace": os.path.abspath(a.workspace)}
    rep: dict = {"bases": bases}

    cur.execute("SELECT id,path,sha256,root FROM store_files WHERE archived=FALSE")
    dbrows = {(r["root"], r["path"]): r for r in cur.fetchall()}

    # workspace 侧只盘点已登记的前两级前缀：否则会扫进 venv/models/tasks 等
    # 十万级无关文件（实测 shared/ 下 venv+models 就有 7.3 万个），orphan 列表直接失真。
    cur.execute("""SELECT DISTINCT substring(path from '^[^/]+/[^/]+') p
                   FROM store_files WHERE root='workspace' AND path LIKE %s""", ("%/%",))
    scopes = sorted({r["p"] for r in cur.fetchall() if r["p"]})
    rep["workspace_scopes"] = scopes

    disk: set[tuple[str, str]] = set()
    for rel in _walk_rel(bases["store"]):
        if rel.startswith("index/"):   # 台账自身（manifest/today/kb-map），不是内容
            continue
        disk.add(("store", rel))
    for sc in scopes:
        for rel in _walk_rel(os.path.join(bases["workspace"], sc)):
            disk.add(("workspace", f"{sc}/{rel}"))

    rep["db_rows"] = len(dbrows)
    rep["disk_files"] = len(disk)
    rep["orphan_db"] = sorted(f"{r}:{p}" for (r, p) in set(dbrows) - disk)[:50]
    rep["orphan_disk"] = sorted(f"{r}:{p}" for (r, p) in disk - set(dbrows))[:50]

    bad_name, bad_char = [], []
    for rn, rel in sorted(disk):
        if rn == "store" and (rel.startswith(".archive/") or rel.startswith("work/")):
            continue
        fn = os.path.basename(rel)
        if BAD_NAME.search(fn):
            bad_name.append(f"{rn}:{rel}")
        if BAD_CHAR.search(fn):
            bad_char.append(f"{rn}:{rel}")
    rep["violations"] = {"bak_in_production_dirs": bad_name[:50],
                         "bad_chars": bad_char[:50], "count": len(bad_name) + len(bad_char)}

    cur.execute("""SELECT sha256,count(*) n,array_agg(path ORDER BY id) paths
                   FROM store_files WHERE sha256<>'' AND archived=FALSE
                   GROUP BY sha256 HAVING count(*)>1""")
    rep["duplicate_sha_groups"] = [dict(r) for r in cur.fetchall()]

    cur.execute("""SELECT id,path,note,status FROM store_files
                   WHERE status IN ('stub','gap','failed') OR note<>'' ORDER BY id""")
    rep["gaps"] = [dict(r) for r in cur.fetchall()]

    cur.execute("""SELECT wiki_status,count(*) n FROM store_files
                   WHERE kind='knowledge' AND archived=FALSE GROUP BY wiki_status ORDER BY n DESC""")
    rep["wiki_status"] = {r["wiki_status"]: r["n"] for r in cur.fetchall()}

    cur.execute("""SELECT d.domain, count(f.id) n FROM store_domains d
                   LEFT JOIN store_files f ON f.domain=d.domain AND f.archived=FALSE
                   GROUP BY d.domain ORDER BY n DESC""")
    rep["domains"] = {r["domain"]: r["n"] or 0 for r in cur.fetchall()}

    cur.execute("""SELECT kind,count(*) n,COALESCE(sum(size),0) bytes FROM store_files
                   WHERE archived=FALSE GROUP BY kind ORDER BY n DESC""")
    rep["by_kind"] = {r["kind"]: {"files": r["n"], "bytes": r["bytes"]} for r in cur.fetchall()}

    conn.close()
    problems = (len(rep["orphan_db"]) + len(rep["orphan_disk"])
                + rep["violations"]["count"] + len(rep["duplicate_sha_groups"]))
    rep["ok"] = problems == 0
    rep["problem_count"] = problems
    out(rep)


def cmd_export(a) -> None:
    conn = connect()
    cur = conn.cursor()
    cur.execute("SELECT * FROM store_files ORDER BY id")
    rows = [dict(r) for r in cur.fetchall()]
    conn.close()
    p = a.out or os.path.join(a.root, "index", "manifest.jsonl")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False, default=str) + "\n")
    out({"ok": True, "path": p, "rows": len(rows),
         "note": "PG 为权威索引，本文件是降级/审计快照"})


def cmd_lineage(a) -> None:
    conn = connect()
    cur = conn.cursor()
    cur.execute("""WITH RECURSIVE down AS (
                     SELECT src_id,dst_id,rel,1 depth FROM store_refs WHERE src_id=%s
                   UNION ALL
                     SELECT r.src_id,r.dst_id,r.rel,d.depth+1 FROM store_refs r
                       JOIN down d ON r.src_id=d.dst_id WHERE d.depth<8),
                   up AS (
                     SELECT src_id,dst_id,rel,1 depth FROM store_refs WHERE dst_id=%s
                   UNION ALL
                     SELECT r.src_id,r.dst_id,r.rel,d.depth+1 FROM store_refs r
                       JOIN up d ON r.dst_id=d.src_id WHERE d.depth<8)
                   SELECT 'downstream' dir,src_id,dst_id,rel FROM down
                   UNION ALL SELECT 'upstream',src_id,dst_id,rel FROM up""", (a.id, a.id))
    edges = [dict(r) for r in cur.fetchall()]
    ids = {a.id} | {e["src_id"] for e in edges} | {e["dst_id"] for e in edges}
    cur.execute("SELECT id,path,kind,domain,status FROM store_files WHERE id = ANY(%s)",
                (list(ids),))
    nodes = {r["id"]: dict(r) for r in cur.fetchall()}
    conn.close()
    out({"root": a.id, "nodes": nodes,
         "edges": [{"dir": e["dir"], "rel": e["rel"],
                    "src": nodes.get(e["src_id"], {}).get("path", e["src_id"]),
                    "dst": nodes.get(e["dst_id"], {}).get("path", e["dst_id"])} for e in edges]})


def cmd_link(a) -> None:
    conn = connect()
    cur = conn.cursor()
    cur.execute("""INSERT INTO store_refs(src_id,dst_id,rel) VALUES(%s,%s,%s)
                   ON CONFLICT DO NOTHING""", (a.src, a.dst, a.rel))
    conn.close()
    out({"ok": True, "src": a.src, "dst": a.dst, "rel": a.rel})


def cmd_today(a) -> None:
    out(write_today(a.root))


def main() -> None:
    ap = argparse.ArgumentParser(prog="store", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=os.environ.get("STORE_ROOT", DEFAULT_ROOT))
    ap.add_argument("--workspace",
                    default=os.environ.get("STORE_WORKSPACE", DEFAULT_WORKSPACE),
                    help="存量盘点基准根（root='workspace' 的行按此解析）")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("init", help="建扩展/表/索引 + 目录骨架 + 种子").set_defaults(f=cmd_init)

    p = sub.add_parser("scan", help="扫描入库（按 path 幂等 upsert）")
    p.add_argument("--src", default="", help="要扫描的目录（默认 store 根）")
    p.add_argument("--kind", default="")
    p.add_argument("--domain", default="")
    p.add_argument("--status", default="indexed")
    p.add_argument("--pattern", default="")
    p.add_argument("--prefix", default="", help="入库 path 前缀（存量盘点用，如 shared/data）")
    p.add_argument("--root-name", dest="root_name", default="store",
                   choices=("store", "workspace"),
                   help="path 的基准根：store=新存储根，workspace=存量盘点")
    p.add_argument("--skip-archive", action="store_true")
    p.set_defaults(f=cmd_scan)

    p = sub.add_parser("add", help="登记单个文件")
    p.add_argument("path")
    p.add_argument("--rel", default="")
    p.add_argument("--kind", default="")
    p.add_argument("--domain", default="")
    p.add_argument("--status", default="indexed")
    p.add_argument("--sender", default="")
    p.add_argument("--task", type=int, default=None)
    p.add_argument("--sensitivity", default="")
    p.add_argument("--authority", default="")
    p.add_argument("--wiki-status", default="")
    p.add_argument("--note", default="")
    p.set_defaults(f=cmd_add)

    p = sub.add_parser("set", help="改台账字段（迁移重映射/登记 wiki/标注缺口）")
    p.add_argument("id", type=int)
    for _f in SETTABLE:
        p.add_argument("--" + _f.replace("_", "-"), dest=_f, default=None)
    p.add_argument("--task-id", dest="task_id", type=int, default=None)
    p.add_argument("--archived", dest="archived", default=None,
                   type=lambda s: s.lower() in ("1", "true", "yes"))
    p.add_argument("--log-wiki", dest="log_wiki", default="",
                   help="同时写 store_wiki_sync 流水：push|verify|pull|tag|skip")
    p.set_defaults(f=cmd_set)

    p = sub.add_parser("q", help="查询")
    for k in ("kind", "domain", "status", "wiki_status", "variant", "sensitivity",
              "authority", "sender", "topic", "path", "since", "until"):
        p.add_argument(f"--{k.replace('_','-')}", dest=k, default="")
    p.add_argument("--task", type=int, default=None)
    p.add_argument("--limit", type=int, default=50)
    p.add_argument("--include-archived", action="store_true")
    p.add_argument("--format", default="table", choices=("table", "json"))
    p.set_defaults(f=cmd_q)

    sub.add_parser("dup", help="sha256 重复检测").set_defaults(f=cmd_dup)
    sub.add_parser("doctor", help="DB↔磁盘对账 + 命名违规 + 缺口").set_defaults(f=cmd_doctor)

    p = sub.add_parser("export", help="PG → index/manifest.jsonl")
    p.add_argument("--out", default="")
    p.set_defaults(f=cmd_export)

    p = sub.add_parser("lineage", help="血缘树")
    p.add_argument("id", type=int)
    p.set_defaults(f=cmd_lineage)

    p = sub.add_parser("link", help="登记血缘边")
    p.add_argument("src", type=int)
    p.add_argument("dst", type=int)
    p.add_argument("--rel", default="derived_from")
    p.set_defaults(f=cmd_link)

    sub.add_parser("today", help="刷新并输出 index/today.json").set_defaults(f=cmd_today)

    a = ap.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
