# 文件名约定：YYYYMMDD_[senderId_][Ttask_]topic[-variant]_vN.ext
FNAME = re.compile(
    r"^(?P<date>\d{8})_(?:(?P<sender>\d+)_)?(?P<task>T\d+)_(?P<topic>.+?)"
    r"(?:-(?P<variant>[a-z0-9]+))?_v(?P<ver>\d+)\.(?P<ext>[A-Za-z0-9]+)$")


def out(obj) -> None:
