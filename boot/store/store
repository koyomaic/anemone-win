    """建目录骨架（含 report/knowledge 的域白名单目录）。纯文件系统操作，不碰数据库。"""
    made = []
    for d in SKELETON:
        p = os.path.join(root, d)
        if not os.path.isdir(p):
            os.makedirs(p, exist_ok=True)
            made.append(d)
    for dom, k, *_ in DOMAINS:
        p = os.path.join(root, "report" if k == "report" else "knowledge", dom)
        if not os.path.isdir(p):
            os.makedirs(p, exist_ok=True)
            made.append(os.path.relpath(p, root))
    return made


