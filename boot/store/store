def is_production_backup(rel: str) -> bool:
    """正式目录里的备份/临时件；这类文件不得按 report/knowledge 参与 wiki 同步。"""
    return not rel.startswith((".archive/", "work/")) and bool(BAD_NAME.search(os.path.basename(rel)))


def classify_backup(rel: str, kind: str, status: str, wiki_status: str, note: str):
    """生产目录备份件强制降级为 archive/backup/skip，防止误入 wiki 同步。"""
    if not is_production_backup(rel):
        return kind, status, wiki_status, note
