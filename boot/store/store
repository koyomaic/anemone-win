def cmd_doctor(a) -> None:
    conn = connect()
    cur = conn.cursor()
    bases = {"store": os.path.abspath(a.root), "workspace": os.path.abspath(a.workspace)}
    rep: dict = {"bases": bases}

    # 含 archived 行：.archive/ 下的文件同样要对账，否则归档即被视为 orphan
    cur.execute("SELECT id,path,sha256,root,archived FROM store_files")
    dbrows = {(r["root"], r["path"]): r for r in cur.fetchall()}

    # workspace 侧只盘点已登记的前两级前缀：否则会扫进 venv/models/tasks 等
    # 十万级无关文件（实测 shared/ 下 venv+models 就有 7.3 万个），orphan 列表直接失真。
    cur.execute("""SELECT DISTINCT substring(path from '^[^/]+/[^/]+') p
                   FROM store_files WHERE root='workspace' AND path LIKE %s""", ("%/%",))
    scopes = sorted({r["p"] for r in cur.fetchall() if r["p"]})
    rep["workspace_scopes"] = scopes

    disk: set[tuple[str, str]] = set()
    for rel in _walk_rel(bases["store"]):
        if rel.startswith("index/"):   # 台账自身（manifest/today/kb-map），不是内容
            continue
        disk.add(("store", rel))
    for sc in scopes:
        for rel in _walk_rel(os.path.join(bases["workspace"], sc)):
            disk.add(("workspace", f"{sc}/{rel}"))

    rep["db_rows"] = len(dbrows)
    rep["disk_files"] = len(disk)
    orphan_db_set = set(dbrows) - disk
    orphan_disk_set = disk - set(dbrows)
    rep["orphan_db_count"] = len(orphan_db_set)
    rep["orphan_disk_count"] = len(orphan_disk_set)
    rep["orphan_db"] = sorted(f"{r}:{p}" for (r, p) in orphan_db_set)[:50]
    rep["orphan_disk"] = sorted(f"{r}:{p}" for (r, p) in orphan_disk_set)[:50]

    bad_name, bad_char = [], []
    bad_bytes = 0
    bad_by_top: dict[str, int] = {}
    for rn, rel in sorted(disk):
        if rn == "store" and (rel.startswith(".archive/") or rel.startswith("work/")):
            continue
        fn = os.path.basename(rel)
        if BAD_NAME.search(fn):
            bad_name.append(f"{rn}:{rel}")
            top = rel.split("/")[0]
            bad_by_top[top] = bad_by_top.get(top, 0) + 1
            try:
                bad_bytes += os.path.getsize(os.path.join(bases[rn], rel))
            except OSError:
                pass
        if BAD_CHAR.search(fn):
            bad_char.append(f"{rn}:{rel}")
    rep["violations"] = {"bak_in_production_dirs": bad_name[:50],
                         "bad_name_total": len(bad_name),
                         "bad_name_bytes": bad_bytes,
                         "bad_name_by_top": bad_by_top,
                         "bad_chars": bad_char[:50],
                         "count": len(bad_name) + len(bad_char)}

    cur.execute("""SELECT count(*) n FROM store_files
                   WHERE fname LIKE %s
                     AND (archived=FALSE OR wiki_status<>'skip'
                          OR status NOT IN ('archived','removed','backup'))""", ("%.bak%",))
    rep["active_backup_rows"] = cur.fetchone()["n"]

    cur.execute("""SELECT sha256,count(*) n,array_agg(path ORDER BY id) paths
                   FROM store_files WHERE sha256<>'' AND archived=FALSE
                   GROUP BY sha256 HAVING count(*)>1""")
    rep["duplicate_sha_groups"] = [dict(r) for r in cur.fetchall()]

    # 缺口＝明确标为 stub/gap/failed 的行（即使已归档也要持续可见，如「录音1 从未转写」）；
    # 普通备注不算缺口，单独计数，否则 gaps 会被迁移说明淹没。
    cur.execute("""SELECT id,path,note,status,archived FROM store_files
                   WHERE status IN ('stub','gap','failed') ORDER BY id""")
    rep["gaps"] = [dict(r) for r in cur.fetchall()]
    cur.execute("SELECT count(*) n FROM store_files WHERE note<>''")
    rep["annotated"] = cur.fetchone()["n"]

    cur.execute("""SELECT wiki_status,count(*) n FROM store_files
                   WHERE kind='knowledge' AND archived=FALSE GROUP BY wiki_status ORDER BY n DESC""")
    rep["wiki_status"] = {r["wiki_status"]: r["n"] for r in cur.fetchall()}

    cur.execute("""SELECT path,wiki_status,archived,wiki_page_id FROM store_files
                   WHERE kind='knowledge'
                     AND (path LIKE 'knowledge/口径方法论/%'
                          OR path LIKE 'knowledge/知识库/%'
                          OR path LIKE 'knowledge/模型库/%'
                          OR path LIKE 'knowledge/案例库/%'
                          OR path LIKE 'knowledge/规则库/%')""")
    four_rows = [dict(r) for r in cur.fetchall()]
    four_canonical = [r for r in four_rows
                      if is_four_lib_rel(r["path"]) and not is_archived_knowledge_rel(r["path"])]
    four_archived = [r for r in four_rows
                     if is_four_lib_rel(r["path"]) and is_archived_knowledge_rel(r["path"])]
    four_stale = [r for r in four_rows if is_stale_four_lib_rel(r["path"])]
    rep["four_lib"] = {
        "rows": len(four_rows),
        "canonical_rows": len(four_canonical),
        "canonical_active": sum(1 for r in four_canonical if not r["archived"]),
        "canonical_archived": sum(1 for r in four_canonical if r["archived"]),
        "archive_dir_rows": len(four_archived),
        "stale_top_level_rows": len(four_stale),
        "stale_top_level_active": sum(1 for r in four_stale if not r["archived"]),
        "wiki_status": {s: sum(1 for r in four_canonical if r["wiki_status"] == s)
                        for s in sorted({r["wiki_status"] for r in four_canonical})},
        "by_lib": {lib: sum(1 for r in four_canonical if four_lib_of(r["path"]) == lib)
                   for lib in FOUR_LIBS},
        "problems": (sum(1 for r in four_canonical if not r["archived"]
                         and r["wiki_status"] not in ("accepted", "indexed"))
                     + sum(1 for r in four_stale if not r["archived"])),
    }

    cur.execute("""SELECT d.domain, count(f.id) n FROM store_domains d
                   LEFT JOIN store_files f ON f.domain=d.domain AND f.archived=FALSE
                   GROUP BY d.domain ORDER BY n DESC""")
    rep["domains"] = {r["domain"]: r["n"] or 0 for r in cur.fetchall()}

    cur.execute("""SELECT kind,count(*) n,COALESCE(sum(size),0) bytes FROM store_files
                   WHERE archived=FALSE GROUP BY kind ORDER BY n DESC""")
    rep["by_kind"] = {r["kind"]: {"files": r["n"], "bytes": r["bytes"]} for r in cur.fetchall()}

    conn.close()
    problems = (rep["orphan_db_count"] + rep["orphan_disk_count"]
                + rep["violations"]["count"] + len(rep["duplicate_sha_groups"])
                + rep["active_backup_rows"])
    rep["ok"] = problems == 0
    rep["problem_count"] = problems
    out(rep)


