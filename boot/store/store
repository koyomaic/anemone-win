def upsert_file(cur, root: str, abspath: str, rel: str, kind: str, status: str,
                domain: str = "", note: str = "", sender_id: str = "",
                task_id=None, sensitivity: str = "", authority: str = "",
                wiki_status: str = "", hash_it: bool = True,
                infer_rel: str = "", root_name: str = "store",
                wiki_tag: str = "", archived: bool | None = None) -> str:
    st = os.stat(abspath)
    fn = os.path.basename(rel)
    parsed = parse_fname(fn)
    ext = parsed.get("ext") or (fn.rsplit(".", 1)[-1].lower() if "." in fn else "")
    fdate = parsed.get("fdate") or ""
    if not fdate:  # 无日期线索：按 mtime 归日
        fdate = date.fromtimestamp(st.st_mtime).isoformat()
    # 域推断必须用「相对扫描源」的路径：存量盘点带 --prefix 时，rel 已含 shared/ 前缀，
    # 直接推断会把前缀段（reports/knowledge）误当成域名。
    dom = domain or parsed.get("domain") or infer_domain(infer_rel or rel, kind)
    cur.execute("SELECT period_fmt,sensitivity FROM store_domains WHERE domain=%s", (dom,))
    r = cur.fetchone()
    pf = r["period_fmt"] if r else "YYYY-MM"
    sens = sensitivity or (r["sensitivity"] if r else "internal")
    now = time.time()
    sha = sha256(abspath) if hash_it else ""
    cur.execute("""INSERT INTO store_files(kind,path,fname,ext,domain,topic,variant,fdate,period,
                     sender_id,task_id,version,size,sha256,status,sensitivity,authority,
                     wiki_tag,wiki_status,archived,note,root,created_at,updated_at)
                   VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
                   ON CONFLICT(path) DO UPDATE SET
                     kind=EXCLUDED.kind, fname=EXCLUDED.fname, ext=EXCLUDED.ext,
                     -- 推断为空时保留既有值：存量文件名不合约定，scan 推不出域/主题/发送人，
                     -- 直接覆盖会把 store set 或迁移时人工填的字段清空。
                     domain=COALESCE(NULLIF(EXCLUDED.domain,''), store_files.domain),
                     topic=COALESCE(NULLIF(EXCLUDED.topic,''), store_files.topic),
                     variant=COALESCE(NULLIF(EXCLUDED.variant,''), store_files.variant),
                     sender_id=COALESCE(NULLIF(EXCLUDED.sender_id,''), store_files.sender_id),
                     fdate=EXCLUDED.fdate, period=EXCLUDED.period,
                     task_id=COALESCE(EXCLUDED.task_id, store_files.task_id),
                     version=EXCLUDED.version, size=EXCLUDED.size,
                     sha256=EXCLUDED.sha256,
                     -- 人工标注粘滞：scan 只刷新自动态，不覆盖 stub/junk/archived/done 等判定，
                     -- 否则重扫一次就把 store set 的结论冲掉。
                     status=CASE WHEN store_files.status IN ('legacy','indexed','raw')
                                 THEN EXCLUDED.status ELSE store_files.status END,
                     sensitivity=COALESCE(NULLIF(EXCLUDED.sensitivity,''), store_files.sensitivity),
                      authority=EXCLUDED.authority,
                      wiki_tag=COALESCE(NULLIF(EXCLUDED.wiki_tag,''), store_files.wiki_tag),
                      wiki_status=CASE WHEN store_files.wiki_status NOT IN ('none','')
                                       THEN store_files.wiki_status ELSE EXCLUDED.wiki_status END,
                     archived=EXCLUDED.archived, root=EXCLUDED.root,
                     note=CASE WHEN EXCLUDED.note<>'' THEN EXCLUDED.note ELSE store_files.note END,
                     updated_at=EXCLUDED.updated_at""",
                (kind, rel, fn, ext, dom, parsed.get("topic") or "", parsed.get("variant") or "",
                 fdate, period_of(fdate, pf), parsed.get("sender_id") or sender_id,
                 parsed.get("task_id", task_id) if parsed else task_id,
                 parsed.get("version") or 1, st.st_size, sha, status, sens,
                  authority or ("jingbowiki" if kind == "knowledge" else "local"),
                   wiki_tag or (dom if kind == "knowledge" else ""),
                   wiki_status or ("skip" if kind == "archive" else "none"),
                   kind == "archive" if archived is None else archived,
                   note, root_name, now, now))
    return rel


def _is_runtime(dirpath: str, name: str) -> bool:
    """运行时目录（虚拟环境/模型缓存/临时区）不属业务存储，一律不扫不索引。

    store 根与 relay 的 shared_dir 同址后，根下就有 venv/venv_funasr/models
    共 7.3 万文件、10.5G；不排除的话 scan/doctor 每次都要遍历它们。
    pyvenv.cfg 是虚拟环境的确定标记，据此泛化识别，不硬编码站点特有目录名。
    """
    if name in RUNTIME_SKIP:
        return True
    return os.path.isfile(os.path.join(dirpath, name, "pyvenv.cfg"))


def _prune(dp: str, dn: list[str], base: str) -> None:
    """就地过滤待遍历子目录：排除运行时目录，以及 UNMANAGED 里列出的非台账路径。

    UNMANAGED 按相对 base 的路径匹配，因此顶层名（secrets）与嵌套路径
    （tools/dingtalk-skills）都能排掉。
    """
    rel = os.path.relpath(dp, base)
    pre = "" if rel == "." else rel.replace(os.sep, "/") + "/"
    dn[:] = [d for d in dn if (pre + d) not in UNMANAGED and not _is_runtime(dp, d)]


def _walk_rel(base: str):
    """列出 base 下所有文件的相对路径（不哈希，纯枚举）。"""
    if not os.path.isdir(base):
        return
    for dp, dn, fn in os.walk(base):
        _prune(dp, dn, base)
        for f in sorted(fn):
            p = os.path.join(dp, f)
            if os.path.isfile(p):
                yield os.path.relpath(p, base)


def walk_files(root: str):
    for dp, dn, fn in os.walk(root):
        _prune(dp, dn, root)
        for f in sorted(fn):
            p = os.path.join(dp, f)
            if os.path.isfile(p):
                yield p, os.path.relpath(p, root)


def cmd_scan(a) -> None:
    src = os.path.abspath(a.src or a.root)
    conn = connect()
    cur = conn.cursor()
    n = skip = backup_marked = 0
    for abspath, rel in walk_files(src):
        if a.pattern and not re.search(a.pattern, rel):
            skip += 1
            continue
        # --prefix 用于存量盘点：旧路径带 shared/ 前缀入库，不与迁移后的 store 路径撞 UNIQUE
        key = f"{a.prefix.rstrip('/')}/{rel}" if a.prefix else rel
        kind = a.kind or infer_kind(rel)
        status = a.status
        wiki_status = ""
        note = ""
        archived = None
        kind, status, wiki_status, note = classify_backup(key, kind, status, wiki_status, note)
        kind, status, wiki_status, note, archived = classify_knowledge_archive(
            key, kind, status, wiki_status, note, archived)
        if is_production_backup(key):
            backup_marked += 1
        if a.skip_archive and kind == "archive":
            skip += 1
            continue
        try:
            upsert_file(cur, src, abspath, key, kind, status, domain=a.domain or "",
                        note=note, wiki_status=wiki_status,
                        infer_rel=rel, root_name=a.root_name, archived=archived)
            n += 1
        except OSError as e:
            print(f"WARN 跳过 {rel}: {e}", file=sys.stderr)
    write_today(a.root)
    conn.close()
    out({"ok": True, "src": src, "prefix": a.prefix or None, "root_name": a.root_name,
         "indexed": n, "skipped": skip, "backup_marked": backup_marked, "status": a.status})


def cmd_add(a) -> None:
    conn = connect()
    cur = conn.cursor()
    p = os.path.abspath(a.path)
    rel = os.path.relpath(p, a.root) if p.startswith(a.root) else a.rel
    kind = a.kind or infer_kind(rel)
    status = a.status
    wiki_status = a.wiki_status or ""
    note = a.note or ""
    archived = None
    kind, status, wiki_status, note = classify_backup(rel, kind, status, wiki_status, note)
    kind, status, wiki_status, note, archived = classify_knowledge_archive(
        rel, kind, status, wiki_status, note, archived)
    upsert_file(cur, a.root, p, rel, kind, status, domain=a.domain or "",
                note=note, sender_id=a.sender or "",
                task_id=a.task, sensitivity=a.sensitivity or "",
                authority=a.authority or "", wiki_status=wiki_status,
                wiki_tag=a.wiki_tag or "", archived=archived)
