def load_db_url() -> str:
    """DB 连接串解析顺序（宿主＝全权限，任务＝最小权限，自动选择）：

    1. `RELAY_DB` 环境变量        —— 宿主 shell / provision
    2. `relay.env` 里的 RELAY_DB  —— 宿主默认；任务侧该文件被 relay.service 的
                                    InaccessiblePaths 物理屏蔽，读不到
    3. `STORE_DB` 环境变量        —— 显式指定
    4. `index/store-task.env`     —— 任务侧唯一可用路径：store init 生成的最小权限
                                    角色（只授 store_* 表 + tasks 的 id/status 两列），
                                    拿不到 users/devices 里的 token 与设备密钥

    任务环境里 RELAY_* 被 executor._scrubbed_environ 整体滤掉，故 1、2 必然落空，
    自动降到 4；宿主侧 1/2 命中，init 建角色/建扩展需要的超级用户权限也就有了。
    """
    url = os.environ.get("RELAY_DB", "").strip()
    if url:
        return url
    p = os.environ.get("STORE_ENV", DEFAULT_ENV)
    if os.path.isfile(p):
        try:
            for line in open(p, encoding="utf-8"):
                line = line.strip()
                if line.startswith("export "):
                    line = line[7:].strip()
                if line.startswith("RELAY_DB="):
                    v = line.split("=", 1)[1].strip().strip('"').strip("'")
                    if v:
                        return v
        except OSError:
            pass  # 任务侧 relay.env 不可见，属预期，继续降级
    url = os.environ.get("STORE_DB", "").strip()
    if url:
        return url
    task_env = os.path.join(os.environ.get("STORE_ROOT", DEFAULT_ROOT), "index", "store-task.env")
    if os.path.isfile(task_env):
        for line in open(task_env, encoding="utf-8"):
            line = line.strip()
            if line.startswith("STORE_DB="):
                v = line.split("=", 1)[1].strip().strip('"').strip("'")
                if v:
                    return v
    raise SystemExit("找不到 DB 连接串：宿主需 RELAY_DB（或 relay.env），任务需 index/store-task.env"
                     "（由 store init 生成）")


def connect():
    c = psycopg2.connect(load_db_url(), connect_timeout=10,
                         cursor_factory=psycopg2.extras.RealDictCursor)
    c.autocommit = True
    return c


def sha256(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def iso_week(d: date) -> str:
    y, w, _ = d.isocalendar()
    return f"{y}-W{w:02d}"


def parse_fname(fn: str) -> dict:
    """按命名约定解析文件名；不合约定返回空 dict（存量文件走人工映射表）。"""
    m = FNAME.match(fn)
    if not m:
        return {}
    g = m.groupdict()
    ds = g["date"]
    d = date(int(ds[:4]), int(ds[4:6]), int(ds[6:]))
    return {"fdate": d.isoformat(), "sender_id": g["sender"] or "",
            "task_id": int(g["task"][1:]) if g["task"] and g["task"] != "T0" else None,
            "topic": g["topic"], "variant": g["variant"] or "",
            "version": int(g["ver"]), "ext": g["ext"]}


def infer_kind(rel: str) -> str:
    """kind 是封闭词表 data|report|knowledge|shared|work|archive。

    顶层目录名不直接当 kind：tools/ skills-proposed/ templates/ 等都属「非经营共享」，
    一律归 shared，否则每次 scan 都会用目录名覆盖掉既有 kind。
    """
    top = rel.split("/")[0]
    return {"data": "data", "report": "report", "work": "work",
            ".archive": "archive", "knowledge": "knowledge"}.get(top, "shared")


def infer_domain(rel: str, kind: str) -> str:
    """从路径推域名。只有 report / knowledge 有域层，data 按日期+发送人分层无域。

    兼容两种布局：
      相对 kind 根（存量盘点 --src shared/reports）：会议纪要/2026-09/x.md
      相对 store 根（正常扫描）：              report/会议纪要/2026-09/x.md
    """
    if kind not in ("report", "knowledge"):
        return ""
    parts = [p for p in rel.split("/") if p]
    if parts and parts[0] in ("report", "data", "work", "shared"):
        parts = parts[1:]
    if parts and parts[0] == "knowledge":
        parts = parts[1:]
    # 至少要有「域/文件」两段，否则说明文件直接位于 kind 根下，无域层
    return parts[0] if len(parts) >= 2 else ""


def period_of(fdate: str, fmt: str) -> str:
    if not fdate:
        return ""
    d = date.fromisoformat(fdate)
    return iso_week(d) if fmt == "YYYY-Www" else fdate[:7]


