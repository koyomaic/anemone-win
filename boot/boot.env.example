# relay-boot 本机配置模板：新机器复制为 /opt/team/relay-boot/boot.env 后按需修改。
# 每机一份、不进部署覆盖范围（boot.sh 自更新永不覆盖 boot.env）；无密钥。
# 下面的值即当前生产机默认值，注释标明哪些通常每机要改。

# 代码唯一真源：机队默认 SSH（deploy key，每机一把；provision 自动生成密钥/固化 ssh config/实测认证，
# 公钥按其 WARN 提示登记到仓库 Settings → Deploy keys，勾选 Allow write access）。
# HTTPS+PAT 为备用（凭据 /root/.git-credentials），SSH 故障时改回：
#   REPO_URL=https://github.com/koyomaic/business_advisor.git
REPO_URL=git@github.com:koyomaic/business_advisor.git
BRANCH=main

# 每机可改：部署布局路径（releases 根 / 现役软链 / python venv）
RELEASE_ROOT=/mnt/vol-eltaah12/finaagent/relay-releases
CURRENT_LINK=/mnt/vol-eltaah12/finaagent/relay-service
VENV=/mnt/vol-eltaah12/finaagent/.venv

# 生产 relay 的 systemd 单元名与健康检查地址（端口与 relay 配置一致，一般不改）
UNIT=relay
HEALTH_URL=http://127.0.0.1:8787/health

# 每机可改：保留 release 份数、bootloader 日志路径
KEEP=3
LOG=/var/log/relay-boot.log

# 每机可改：更新失败钉钉预警接收人（dws 直聊，写姓名）
ALERT_TO=王洪彬

# 可选覆盖（一般不设，用默认值）：
# RELAY_CA_SRC=127.0.0.1:8788
#   team-agent-relay 安装位 ca.pem 的提取源（TLS 链第 2 张自签 CA 证书；公开文件，不入 git）
# DWS_SEED=/mnt/vol-eltaah12/workspace/shared/secrets/dws-cli-seed/dws-cli
#   dws 共享登录态种子目录（notify_failure 软链进临时 HOME 直用；目录不存在时退回 HOME=/root 直发）
# DWS_BIN=/usr/bin/dws
#   dws 可执行文件路径
# DEV_DIR=/mnt/vol-eltaah12/finaagent/relay-dev
#   本地开发工作区路径（boot 每轮自动 fetch+fast-forward 同步到远端 main；设不存在的路径即跳过）
# STORE_DIR=/opt/team/store
#   store 台账 CLI 安装位（provision 21e 从仓库 boot/store/store 内容级同步，并软链 /usr/local/bin/store）
# STORE_ROOT=/mnt/vol-eltaah12/workspace/shared
#   store 存储根＝relay 的 shared_dir（同址是刻意的：relay 的 _snap 用 os.walk 默认不跟随
#   符号链接，若把 store 放别处再用软链兼容，knowledge/report 会整个从基线快照里消失、
#   静默破坏冲突检测）。改这里必须同步改 RELAY_SHARED，否则两者脱节。
#   注意：store init 会在 RELAY_DB 指向的库里建 5 张 store_* 表，属有副作用操作，
#   provision 只探活不自动建表，首次需人工执行 store init。
