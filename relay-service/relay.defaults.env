# 团队中转服务 · 全机队统一默认配置（进 git，随版本发布）
# 机器差异/密钥不放这里：各机 /mnt/vol-eltaah12/workspace/relay.env 只放
# RELAY_ADMIN_TOKEN、RELAY_DASHBOARD_PASSWORD 及个别本机覆盖项（后加载，覆盖本文件）。
# systemd 加载顺序：relay.defaults.env（本文件）→ relay.env（本机）

# ---- 路径（全机队统一布局）----
RELAY_WORKSPACE=/mnt/vol-eltaah12/workspace

# ---- 数据库 ----
# 缺省 SQLite：$RELAY_WORKSPACE/relay.db。切换 PostgreSQL：在本机 relay.env 里设
# RELAY_DB=postgresql://USER:PASSWORD@HOST:5432/DBNAME（密钥不进 git，故不放本文件），
# 存量数据用 relay-service/scripts/migrate_sqlite_to_pg.py 一次性迁移。

# ---- 调度与超时 ----
# 并发上限：4核/8G 机型实测 8 路无压力（opencode 进程主要在等远端模型）
RELAY_MAX_CONCURRENT=8
RELAY_TASK_TIMEOUT=1800
# review 停留超时自动 done（小时）；超时清扫周期（秒）
# 24→8（2026-10-12 机队统一）：白天提交的任务当天闭环，减少过夜挂起的未确认会话。
# 背景：avatar 重启会触发「门禁态会话重提示」，夜间部署重启（01:00）撞上未确认
# review 会话即凌晨发提醒（2026-10-11 实例）；8h 在保住验收窗与压缩夜间触发面之间折中。
RELAY_STALE_TIMEOUT_HOURS=8
RELAY_SWEEP_INTERVAL_SEC=300
# 待审批（pending_approval）停留超时 → 自动 **failed**（分钟）。与 review 分开：
# review 是"活已干完等人过目"，超时置 done 无损；待审批是"活干到一半被门禁拦住"，
# 此前与 review 共用一条 UPDATE 被置成 done，等于把没办完的任务报成办完了。
# 无 blocked_at 列（不迁移 schema），超时从 created_at 起算，故需覆盖"任务本身跑掉的
# 时间 + 留给人决策的时间"：任务时限 1800s(30min)，60min 意味着最坏情况仍有 30min 决策窗。
RELAY_APPROVAL_TIMEOUT_MINUTES=60
# 侦察类命令（凭据枚举/翻分身安装目录）自动拒绝并回注提示续跑的次数上限；超限转人工。
# 每次续跑都是一次完整 claude 调用，限次防 agent 反复试探把续跑变成死循环烧配额。
RELAY_AUTO_DENY_MAX=2

# ---- 终态临时清理 ----
# 任务进入终态（done/conflict/failed/cancelled）后自动删除其 workdir 的临时目录
# home/（agent 缓存）与 data/（工作数据）；保留 .result/（变更文件，供跨任务冲突
# 备份）与 .baseline.json。置 0 关闭（保留完整 workdir）。
RELAY_CLEANUP_RUNTIME=1

# ---- 冲突判定与备份（app/workspace.py）----
# 同文件冲突的时间窗（小时）：窗外的先后写入属正常演进，不判冲突。
RELAY_CONFLICT_WINDOW_HOURS=24
# 工具自动重写的运行时产物（fnmatch 通配，匹配工作区相对路径）：不计产出、不参与冲突判定。
# 留空 = 用代码内默认清单（见 app/config.py DEFAULT_VOLATILE_PATTERNS：*auth-token*、
# *.token_cache、.token_cache、*.bak-*、*.pyc）。
# RELAY_VOLATILE_PATTERNS=
# 冲突备份的单文件体积上限（MB）：超过则只记入 conflicts 并写明跳过原因，不拷贝。
# 另有硬规则：位于运行时目录（venv/models/.archive/index/work/data 等，见 workspace.py
# SKIP_DIRS 与按 pyvenv.cfg 的泛化识别）的文件一律不备份。
# 历史事故：无上限的 copy2 让一个声明宽 target 的任务把 venv/models 整棵树备份成
# 18972 个 .bak、4.92G（单个 model.bin.bak 1.5G，还拷了两份），2026-09-22 清理回收 7G。
RELAY_BACKUP_MAX_MB=50

# ---- 执行引擎 ----
# opencode | claude（Claude Code CLI）。切 claude 前置条件：本机装有 claude CLI、
# claude-proxy.service 在跑（Anthropic→OpenAI 本地转换，仓库 claude-code-openai-proxy/），
# 且 relay.env 配好下方 ANTHROPIC_* 透传。回退 = 改回 opencode + 重启，无数据迁移。
RELAY_ENGINE=opencode
# 留空 = 用 opencode 全局配置的默认模型；切换示例：chambroad/Qwen3.8-27B-FP8-LCBD、
# aigateway/qwen3.8-max、aigateway/qwen3.8-flash
# engine=claude 时留空 = 用 ANTHROPIC_MODEL；非空则作为 --model 显式传入
RELAY_MODEL=
# claude 引擎的鉴权/模型走进程 env 透传（任务 HOME 隔离，读不到全局 ~/.claude/settings.json）。
# 值放各机 relay.env（600），示例：
#   ANTHROPIC_BASE_URL=http://127.0.0.1:8790
#   ANTHROPIC_AUTH_TOKEN=<claude-proxy 本地代理不校验，非空即可>
#   ANTHROPIC_MODEL=Qwen3.8-27B-FP8-LCBD
#   ANTHROPIC_SMALL_FAST_MODEL=Qwen3.8-27B-FP8-LCBD
#   CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# 任务环境剔除的 provider（逗号分隔；默认模型所在 provider 永不剔除）
RELAY_EXCLUDE_PROVIDERS=

# ---- 外部先进模型 strict 脱敏出口（claude-code-openai-proxy :8792）----
# required 时，声明为外部的 opencode provider 会被任务配置改写到本机脱敏代理；
# claude 引擎若当前模型声明为外部模型，也会先探活代理。代理/词典不健康即 fail-closed。
# 只支持 strict：出站脱敏 + 响应/tool args 还原 + 响应 DLP + 附件不出网。
RELAY_EXTERNAL_MODEL_REDACTION=off
RELAY_EXTERNAL_PROXY_URL=
# 逗号分隔的外部 provider 名（例：aigateway）；本地模型 provider 不要列入。
RELAY_EXTERNAL_PROVIDERS=
# 逗号分隔的外部模型名（例：qwen3.8-flash,qwen3.8-max）；用于 claude 引擎守卫。
RELAY_EXTERNAL_MODELS=
RELAY_REDACTION_HEALTH_REQUIRED=0
RELAY_REDACTION_HEALTH_TIMEOUT=2

# ---- 更新机制 ----
RELAY_BOOT_CMD=/opt/team/relay-boot/boot.sh
# 要求的最低客户端（team-agent-relay skill）版本；/health 透出 min_client_version，
# 客户端 `relay.py version` 检测到低于要求时软提醒升级（不阻塞）。
# 1.4.0=设备签名认证起步版本，旧包 bearer 已被服务端拒绝（RELAY_AUTH_LEGACY=0）。
# 1.4.1=传输安全加固：客户端拒绝明文 http、ca.pem 独占 pinning、缺失 fail-fast。
RELAY_MIN_CLIENT_VERSION=1.4.1

# ---- 认证（token=一次性激活码 + 设备 HMAC 签名） ----
# 硬切换：生产默认关闭旧式 bearer token 认证——token 仅作一次性激活码，
# 激活绑定设备后请求一律 HMAC 签名；旧客户端（<1.4.0）将 401，需升级技能包。
# 如需临时过渡双轨可置 1（/admin/report 的 legacy_auths 可观测旧式认证量）。
RELAY_AUTH_LEGACY=0
# 设备签名时间窗（秒），防重放；900=容忍成员机器时钟漂移（重放仍被 nonce 缓存拦截）
RELAY_SIGN_WINDOW=900

# ---- 高危命令拦截（留空 = 用代码内默认核心清单，见 app/config.py）----
# 默认清单含中转自身保护：git 写子命令（push/commit/rebase/reset 等）、systemctl 控制动词、
# pkill relay 系；git 只读（log/diff/status/clone）与 systemctl status 不拦。
# 注意：本层是审计+审批（可人工批准豁免）；硬边界在 relay.service 沙箱（ProtectSystem=strict），
# 代码树/relay.env/GitHub 凭据对任务物理不可写/不可见，批准了也写不动，例外须人在宿主机操作。
# RELAY_BLOCKED_PATTERNS=
# RELAY_RM_SAFE_PREFIXES=/tmp,/var/tmp

# ---- 任务级共享 venv（pip install 落点）----
# 沙箱下系统/服务 venv 只读；此 venv 位于可写区，其 bin 前置进任务 PATH，裸 pip install 直接可用。
# 缺省 = <RELAY_SHARED>/venv；provision.sh §22b 负责创建。
# RELAY_SHARED_VENV=

# ---- dws 消息发送二次确认（app/executor.py _confirm_violation 门控）----
# agent 经 dws 发钉钉消息/DING 时：任一接收人精确等于本清单某项（字符串整 token
# 精确匹配，"1" 为马韵升 userId，不子串匹配以免误伤 37505774 等含 1 的 ID）、
# 或接收人 ≥2 个、或目标为群聊/会话 → 拦截进 pending_approval，人工 approve 后续跑。
# 单发给其他普通人不拦。留空 = 用代码内默认清单。
RELAY_CONFIRM_RECIPIENTS=马韵升,1,D3QFnNNkA4zsa6fEkz0vxWVZZG4c4SxTc

# ---- 计划（定时任务）----
# 大脑/成员经 POST /plans 写声明（name + OnCalendar + 动作），root 侧 relay-plan.timer
# 每分钟扫库、原子认领并 POST /tasks 触发。大脑全程不碰 systemctl / 不写 /etc，
# relay.service 的 ProtectSystem=strict 硬边界原样保留。计划存本机各自的库（不跨机共享）。
# 触发器脚本 /opt/team/relay-boot/plan-tick.sh 读 relay.env 的 RELAY_ADMIN_TOKEN 调本机
# relay；如需改触发目标可设 RELAY_BASE（默认 http://127.0.0.1:8787）、RELAY_ENV。
# 日志 /var/log/relay-plan.log。OnCalendar 下次触发由 systemd-analyze calendar 计算（零依赖）。
